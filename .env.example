# Pooled connection for the least-privilege diuboard_app role.
DIU_DATABASE_URL="postgresql://diuboard_app:PASSWORD@HOST-pooler.REGION.aws.neon.tech/Routines?sslmode=require&channel_binding=require"
# Direct neondb_owner connection, used only by npm run db:migrate.
DIU_DATABASE_URL_UNPOOLED="postgresql://neondb_owner:PASSWORD@HOST.REGION.aws.neon.tech/Routines?sslmode=require&channel_binding=require"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_ROUTINE_MODEL="gemini-3.8-flash"
SCRAPER_USER_AGENT="NoticeTrackerBot/1.0"
ROUTINE_SYNC_SECRET=""
SYNC_INTER_REQUEST_DELAY_MS="200"
NOTICE_SYNC_MAX_PAGES="5"
ROUTINE_INTER_DEPARTMENT_DELAY_MS="250"
